{
  "name": "agentskills",
  "version": "1.0.0",
  "description": "The ultimate modular AI agent skills vault for Antigravity, Claude Code, Cursor, and Windsurf.",
  "scripts": {
    "add": "npx -y skills add",
    "install-all": "npx -y skills add SeaXen/agentskills --all",
    "activate": "python library/activate_skill.py activate",
    "link": "python library/activate_skill.py link",
    "remove": "python library/activate_skill.py remove",
    "find": "python update.py --find",
    "update": "python update.py",
    "reindex": "python update.py --index"
  },
  "keywords": [
    "agent-skills",
    "ai-agents",
    "antigravity",
    "claude-code",
    "cursor",
    "windsurf",
    "skills",
    "developer-tools"
  ],
  "author": "SeaXen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeaXen/agentskills.git"
  }
}
