# The absorbed scripts are byte-exact copies of their source skills and their
# integrity is verified by sha256 (scripts/absorbed/MANIFEST.json, checked by
# scripts/absorbed/verify_manifest.py).  Git must not rewrite their line
# endings: with core.autocrlf=true a CRLF conversion would make every copy
# report as drifted on a fresh checkout, so `skill_check.py` would fail on a
# clean clone for no reason at all.
scripts/absorbed/*.py -text
scripts/absorbed/MANIFEST.json -text

# The same rule for the absorbed knowledge pack: every copy under
# references/knowledge/ is recorded in references/knowledge/MANIFEST.json with
# the sha256 of the copy, so a CRLF conversion would break the check.
references/knowledge/** -text
